import React from "react";
import {
  View,
  Text,
  StyleSheet,
  ScrollView,
  TouchableOpacity,
} from "react-native";
import { useAuth } from "../context/AuthContext";

const ROLE_COLORS: Record<string, string> = {
  admin: "#6366f1",
  subadmin: "#8b5cf6",
  dealer: "#0ea5e9",
  dealer_member: "#06b6d4",
  reporting_authority: "#f59e0b",
  manager: "#10b981",
  sales: "#3b82f6",
  campaign_master: "#ef4444",
};

export default function DashboardScreen() {
  const { currentUser, logout } = useAuth();
  const roleColor = ROLE_COLORS[currentUser?.role || "sales"] || "#6366f1";

  return (
    <ScrollView style={styles.container} contentContainerStyle={{ paddingBottom: 32 }}>
      {/* Header */}
      <View style={styles.header}>
        <View>
          <Text style={styles.greeting}>Welcome back,</Text>
          <Text style={styles.userName}>{currentUser?.name || "User"}</Text>
        </View>
        <View style={[styles.avatarCircle, { backgroundColor: roleColor }]}>
          <Text style={styles.avatarText}>{currentUser?.avatar || "U"}</Text>
        </View>
      </View>

      {/* Role Badge */}
      <View style={[styles.roleBadge, { backgroundColor: roleColor + "22", borderColor: roleColor }]}>
        <Text style={[styles.roleText, { color: roleColor }]}>
          {String(currentUser?.role || "user").replace(/_/g, " ").toUpperCase()}
        </Text>
      </View>

      {/* Stats Placeholder */}
      <Text style={styles.sectionTitle}>Overview</Text>
      <View style={styles.statsRow}>
        {[
          { label: "Total Leads", value: "—" },
          { label: "Active", value: "—" },
          { label: "Converted", value: "—" },
        ].map(s => (
          <View key={s.label} style={styles.statCard}>
            <Text style={styles.statValue}>{s.value}</Text>
            <Text style={styles.statLabel}>{s.label}</Text>
          </View>
        ))}
      </View>

      {/* Quick Actions */}
      <Text style={styles.sectionTitle}>Quick Actions</Text>
      <View style={styles.actionsGrid}>
        {[
          { label: "My Leads", icon: "📋" },
          { label: "Pipeline", icon: "📊" },
          { label: "Activities", icon: "⚡" },
          { label: "Reports", icon: "📈" },
        ].map(a => (
          <TouchableOpacity key={a.label} style={styles.actionCard}>
            <Text style={styles.actionIcon}>{a.icon}</Text>
            <Text style={styles.actionLabel}>{a.label}</Text>
          </TouchableOpacity>
        ))}
      </View>

      {/* Logout */}
      <TouchableOpacity style={styles.logoutBtn} onPress={logout}>
        <Text style={styles.logoutText}>Sign Out</Text>
      </TouchableOpacity>
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: "#0f172a",
    padding: 20,
  },
  header: {
    flexDirection: "row",
    justifyContent: "space-between",
    alignItems: "center",
    marginBottom: 16,
    marginTop: 8,
  },
  greeting: {
    color: "#94a3b8",
    fontSize: 14,
  },
  userName: {
    color: "#f1f5f9",
    fontSize: 22,
    fontWeight: "700",
  },
  avatarCircle: {
    width: 48,
    height: 48,
    borderRadius: 24,
    alignItems: "center",
    justifyContent: "center",
  },
  avatarText: {
    color: "#fff",
    fontSize: 16,
    fontWeight: "700",
  },
  roleBadge: {
    alignSelf: "flex-start",
    borderWidth: 1,
    borderRadius: 20,
    paddingHorizontal: 12,
    paddingVertical: 4,
    marginBottom: 24,
  },
  roleText: {
    fontSize: 11,
    fontWeight: "700",
    letterSpacing: 1,
  },
  sectionTitle: {
    color: "#cbd5e1",
    fontSize: 15,
    fontWeight: "600",
    marginBottom: 12,
  },
  statsRow: {
    flexDirection: "row",
    gap: 10,
    marginBottom: 24,
  },
  statCard: {
    flex: 1,
    backgroundColor: "#1e293b",
    borderRadius: 12,
    padding: 16,
    alignItems: "center",
  },
  statValue: {
    color: "#f1f5f9",
    fontSize: 22,
    fontWeight: "700",
  },
  statLabel: {
    color: "#64748b",
    fontSize: 11,
    marginTop: 4,
    textAlign: "center",
  },
  actionsGrid: {
    flexDirection: "row",
    flexWrap: "wrap",
    gap: 10,
    marginBottom: 32,
  },
  actionCard: {
    width: "47%",
    backgroundColor: "#1e293b",
    borderRadius: 12,
    padding: 20,
    alignItems: "center",
    gap: 8,
  },
  actionIcon: {
    fontSize: 28,
  },
  actionLabel: {
    color: "#cbd5e1",
    fontSize: 13,
    fontWeight: "600",
  },
  logoutBtn: {
    backgroundColor: "#1e293b",
    borderWidth: 1,
    borderColor: "#ef4444",
    borderRadius: 8,
    paddingVertical: 14,
    alignItems: "center",
  },
  logoutText: {
    color: "#ef4444",
    fontSize: 15,
    fontWeight: "600",
  },
});
